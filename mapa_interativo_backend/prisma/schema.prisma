generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id         String       @id @default(uuid())
  email      String       @unique
  senha      String
  isAdmin    Boolean      @default(false)
  nome       String?
  criadoEm   DateTime     @default(now())
  favoritos  Favorito[]
  avaliacoes  Avaliacao[]
  comentarios Comentario[]
}

model Cidade {
  id    String @id @default(uuid())
  nome  String
  zonas Zona[]
}

model Zona {
  id       String           @id @default(uuid())
  nome     String
  cidadeId String
  cidade   Cidade           @relation(fields: [cidadeId], references: [id])
  pontos   PontoInteresse[]
}

model PontoInteresse {
  id              String                 @id @default(uuid())
  nome            String
  descricao       String
  latitude        Float
  longitude       Float
  imagens         String[]
  zonaId          String
  zona            Zona                   @relation(fields: [zonaId], references: [id])
  acessibilidades Acessibilidade[]
  criadoEm        DateTime               @default(now())
  favoritos       Favorito[]
  horarios        HorarioFuncionamento[]
  atividades      Atividade[]
  eventos         Evento[]
  avaliacoes      Avaliacao[]
  comentarios     Comentario[]
}

model Acessibilidade {
  id      String         @id @default(uuid())
  tipo    String
  pontoId String
  ponto   PontoInteresse @relation(fields: [pontoId], references: [id], onDelete: Cascade)
}

model Favorito {
  id        String         @id @default(uuid())
  usuarioId String
  pontoId   String
  usuario   Usuario        @relation(fields: [usuarioId], references: [id])
  ponto     PontoInteresse @relation(fields: [pontoId], references: [id], onDelete: Cascade)
  criadoEm  DateTime       @default(now())

  @@unique([usuarioId, pontoId])
}

model HorarioFuncionamento {
  id         String         @id @default(uuid())
  diaSemana  String
  abertura   String
  fechamento String
  pontoId    String
  ponto      PontoInteresse @relation(fields: [pontoId], references: [id], onDelete: Cascade)
}

model Atividade {
  id        String         @id @default(uuid())
  nome      String
  descricao String
  pontoId   String
  ponto     PontoInteresse @relation(fields: [pontoId], references: [id], onDelete: Cascade)
}

model Evento {
  id        String         @id @default(uuid())
  nome      String
  descricao String
  data      DateTime
  pontoId   String
  ponto     PontoInteresse @relation(fields: [pontoId], references: [id], onDelete: Cascade)
  criadoEm  DateTime       @default(now())
}

model Avaliacao {
  id        String         @id @default(uuid())
  estrelas  Int
  usuarioId String
  pontoId   String
  usuario   Usuario        @relation(fields: [usuarioId], references: [id])
  ponto     PontoInteresse @relation(fields: [pontoId], references: [id], onDelete: Cascade)
  criadoEm  DateTime       @default(now())

  @@unique([usuarioId, pontoId])
}

model Comentario {
  id        String         @id @default(uuid())
  texto     String
  usuarioId String
  pontoId   String
  usuario   Usuario        @relation(fields: [usuarioId], references: [id])
  ponto     PontoInteresse @relation(fields: [pontoId], references: [id], onDelete: Cascade)
  criadoEm  DateTime       @default(now())
}
